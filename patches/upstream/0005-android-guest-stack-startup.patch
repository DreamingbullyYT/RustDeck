-#[cfg(not(target_os = "linux"))]
+// NativeActivity cannot re-exec itself to enlarge the initial thread stack.
+// Android's main-thread stack is OS-managed; don't abort startup merely because
+// this crate's platform stack inspection is unsupported there. Guest-capable
+// worker threads still use builder()/spawn() and retain their explicit reserve.
+#[cfg(target_os = "android")]
+fn prepare() -> std::io::Result<()> {
+    Ok(())
+}
+
+#[cfg(all(not(target_os = "linux"), not(target_os = "android")))]
 fn prepare() -> std::io::Result<()> {
     // Executable link settings reserve the same stack on Windows and macOS.
     inspect_current().map_err(std::io::Error::other)
 }

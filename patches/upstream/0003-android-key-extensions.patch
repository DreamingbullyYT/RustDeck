@@ -0,0 +1,30 @@
+//! Android stand-ins for winit's desktop-only key extensions (RustDeck patch 0003).
+//!
+//! winit builds `platform::modifier_supplement` and `platform::scancode` only for Windows, macOS, X11
+//! and Wayland. Same method names, so the callers only change which `use` they take on Android:
+//! the key without modifiers is the logical key, and there is no platform scan code.
+
+use winit::event::KeyEvent;
+use winit::keyboard::{Key, PhysicalKey};
+
+/// `winit::platform::modifier_supplement::KeyEventExtModifierSupplement`.
+pub trait KeyEventExtModifierSupplement {
+    fn key_without_modifiers(&self) -> Key;
+}
+
+impl KeyEventExtModifierSupplement for KeyEvent {
+    fn key_without_modifiers(&self) -> Key {
+        self.logical_key.clone()
+    }
+}
+
+/// `winit::platform::scancode::PhysicalKeyExtScancode`.
+pub trait PhysicalKeyExtScancode {
+    fn to_scancode(self) -> Option<u32>;
+}
+
+impl PhysicalKeyExtScancode for PhysicalKey {
+    fn to_scancode(self) -> Option<u32> {
+        None
+    }
+}

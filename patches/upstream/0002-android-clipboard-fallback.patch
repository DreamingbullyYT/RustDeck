--- /dev/null
+++ b/crates/horizon-client-input/src/android_clipboard.rs
@@ -0,0 +1,22 @@
+//! Android stand-in for the `arboard` crate, which has no Android backend (RustDeck patch 0002).
+//! No system clipboard can be reached, so `SystemClipboard` keeps its in-game fallback: text copied
+//! in the game can still be pasted in the game.
+
+pub struct Clipboard;
+
+#[derive(Debug)]
+pub enum Error {
+    ContentNotAvailable,
+}
+
+impl Clipboard {
+    pub fn new() -> Result<Self, Error> {
+        Err(Error::ContentNotAvailable)
+    }
+    pub fn get_text(&mut self) -> Result<String, Error> {
+        Err(Error::ContentNotAvailable)
+    }
+    pub fn set_text(&mut self, _text: String) -> Result<(), Error> {
+        Err(Error::ContentNotAvailable)
+    }
+}

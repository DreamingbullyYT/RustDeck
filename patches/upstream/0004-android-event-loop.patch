+++ b/crates/horizon-client/src/android_app.rs
@@ -0,0 +1,29 @@
+//! The winit event loop. Android needs the `AndroidApp` that `android_main` receives for every
+//! event loop it builds (RustDeck patch 0004); elsewhere this is `EventLoop::new()`.
+
+use winit::{error::EventLoopError, event_loop::EventLoop};
+
+#[cfg(target_os = "android")]
+static APP: std::sync::OnceLock<winit::platform::android::activity::AndroidApp> =
+    std::sync::OnceLock::new();
+
+/// Stores the `AndroidApp` for the event loops built later. Called once by `android_main`.
+#[cfg(target_os = "android")]
+pub fn set_app(app: winit::platform::android::activity::AndroidApp) {
+    let _ = APP.set(app);
+}
+
+/// A new event loop for this platform.
+pub fn event_loop() -> Result<EventLoop<()>, EventLoopError> {
+    #[cfg(target_os = "android")]
+    {
+        use winit::platform::android::EventLoopBuilderExtAndroid;
+        let app = APP
+            .get()
+            .expect("android_main stores the AndroidApp before the game starts")
+            .clone();
+        EventLoop::builder().with_android_app(app).build()
+    }
+    #[cfg(not(target_os = "android"))]
+    EventLoop::new()
+}
